{
  "name": "ambicaindustries-workspace",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix backend install",
    "postinstall": "npm --prefix backend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  }
}
